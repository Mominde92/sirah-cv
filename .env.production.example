# Production settings for cPanel. Copy to .env on the server and fill in the blanks.
# Never commit the real .env.

APP_NAME=Sirah
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=daily
LOG_LEVEL=warning

# cPanel → MySQL Databases: create the database and user, add the user with ALL PRIVILEGES.
# cPanel prefixes names with your account, e.g. cpuser_sirah.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpuser_sirah
DB_USERNAME=cpuser_sirah
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
FILESYSTEM_DISK=local

# Shared hosting: no long-running worker, the cron job processes the queue every minute.
QUEUE_CONNECTION=database
QUEUE_RUN_FROM_SCHEDULER=true

# Email via Resend (resend.com → API Keys). Verify your sending domain in Resend first.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Brevo alternative:
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_SCHEME=null
# MAIL_USERNAME=your-brevo-login
# MAIL_PASSWORD=your-brevo-smtp-key

# First administrator (created by `php artisan db:seed --force`).
ADMIN_NAME="Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

CV_PRIVATE_DISK=local
CV_PUBLIC_DISK=public
CV_UPLOAD_MAX_KB=10240
CV_EXPORT_RETENTION_HOURS=24
CV_DOWNLOAD_URL_TTL=15
CV_HIGHLIGHTED_PLAN=pro

PDF_DRIVER=mpdf

# Optional
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
